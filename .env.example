# Runtime
ENVIRONMENT=local            # local | dev | staging | prod
SECRETS_BACKEND=env          # env (dotenv, local) | aws (AWS Secrets Manager)
AWS_REGION=us-east-1
AWS_SECRETS_PREFIX=cve-remediation/

# Database (also used by LangGraph checkpointer)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/cve_remediation

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# GitHub
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxx
GITHUB_ORG=your-org-name
GITHUB_API_URL=https://api.github.com
GITHUB_SECONDS_BETWEEN_REQUESTS=0.25
GITHUB_SECONDS_BETWEEN_WRITES=1.0

# Internal LLM
LLM_API_BASE_URL=https://internal-llm.company.com
LLM_API_KEY=your-internal-llm-key
LLM_MODEL_NAME=your-model-name
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=120
LLM_CONTEXT_MAX_TOKENS=8000

# Internal Teams API
TEAMS_API_ENDPOINT=https://internal-teams.company.com/api/notify
TEAMS_API_KEY=your-teams-api-key

# Confluence
CONFLUENCE_BASE_URL=https://company.atlassian.net
CONFLUENCE_SPACE_KEY=SEC
CONFLUENCE_PARENT_PAGE_ID=123456
CONFLUENCE_USER=automation@company.com
CONFLUENCE_API_TOKEN=your-confluence-token

# JIRA
JIRA_BASE_URL=https://company.atlassian.net
JIRA_PROJECT_KEY=SEC
JIRA_USER=automation@company.com
JIRA_API_TOKEN=your-jira-token

# MinIO / S3
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_SBOM=cve-sboms
S3_BUCKET_LOGS=cve-job-logs

# CVE feeds
NVD_API_KEY=
NVD_API_BASE_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
OSV_API_BASE_URL=https://api.osv.dev

# GitHub webhooks (HMAC secret configured on the org webhook; the endpoint fails closed without it)
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret

# Control API
CONTROL_API_URL=http://localhost:8000
API_KEY=your-control-api-key
CONTROL_API_IP_ALLOWLIST=

# JIRA / Confluence behaviour (integrations are on only when their API token is set)
JIRA_ISSUE_TYPE=Task
JIRA_SEVERITIES=CRITICAL,HIGH
JIRA_STATUS_TRANSITIONS={"PR_RAISED":"In Review","MERGED":"Done","BLOCKED":"Blocked"}

# Pull requests
PR_BRANCH_PREFIX=fix/cve-
PR_LABELS=security,cve-fix,automated
OWNER_EMAIL_DOMAIN=                              # optional: maps GitHub @user -> user@domain

# Pipeline
MAX_NEW_JOBS_PER_RUN=50            # cap on jobs created per matcher run (protects LLM spend)
FAILED_JOB_RETRY_AFTER_HOURS=24
SLA_ESCALATION_AFTER_HOURS=24
SYFT_BIN=syft
SBOM_TIMEOUT_SECONDS=300
REPO_LOCK_TTL_SECONDS=10800
SANDBOX_SLOTS_BACKEND=local        # local | redis (redis = one cap shared by every worker; use in dev/staging/prod)
SANDBOX_SLOT_LEASE_SECONDS=21600

# Thresholds
MIN_CVSS_THRESHOLD=4.0
SANDBOX_TIMEOUT_SECONDS=600

# Repo selection
REPO_ALLOWLIST=
REPO_BLOCKLIST=legacy-app,archived-service

# Notifications
ENABLED_NOTIFICATION_CHANNELS=teams,webhook
WEBHOOK_URL=https://your-webhook-endpoint.com/cve-alerts
WEBHOOK_SECRET=your-webhook-secret

# Email
SMTP_HOST=smtp.company.com
SMTP_PORT=587
SMTP_USER=automation@company.com
SMTP_PASSWORD=your-smtp-password
EMAIL_FROM=cve-bot@company.com

# PagerDuty
PAGERDUTY_ROUTING_KEY=your-pagerduty-key

# --- v1 locked additions ---
# Agent loop / triage
MAX_FIX_ATTEMPTS=3
REACHABILITY_MODE=advisory   # enforce | advisory

# Sandbox
SANDBOX_NETWORK_MODE=none    # none | registry-allowlist
MAX_CONCURRENT_SANDBOXES=10
SANDBOX_IMAGE_PYTHON=cve-sandbox-python:latest   # build: docker build -f docker/sandbox/python.Dockerfile -t cve-sandbox-python docker/sandbox
SANDBOX_EGRESS_NETWORK=cve-sandbox-egress        # registry-allowlist mode: must be an INTERNAL docker network fronted by an allowlisting proxy
SANDBOX_PROXY_URL=
SANDBOX_PIP_INDEX_URL=
SANDBOX_ALLOW_NON_INTERNAL_NETWORK=false         # local dev only
SANDBOX_MEM_LIMIT=2g
SANDBOX_CPU_QUOTA=50000
SANDBOX_PIDS_LIMIT=256
REQUIRE_TESTS=true                               # repos without tests are not auto-fixed

# Safety / supply chain
AUTOMATION_ENABLED=true
SUPPLY_CHAIN_VERIFY=true

# Data / redaction
CONTEXT_FILE_ALLOWLIST_ENFORCED=true
REDACT_SECRETS_IN_AUDIT=true

# Observability
CLOUDWATCH_NAMESPACE=CVEAutoRemediation
XRAY_ENABLED=true
